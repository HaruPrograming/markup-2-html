tml-to-markdown');\nvar markdown = converter.convert('<h2> Happy Journey </h2>');\n```\n\n## Extending to add your own formatters.\n\n```javascript\nvar converter = require('html-to-markdown');\nconverter.use(function (html) {\n  // making required changes\n  // and return new html\n})\n```\n","maintainers":[{"name":"amanvirk","email":"virk.officials@gmail.com"}],"time":{"modified":"2022-06-18T21:58:15.767Z","created":"2015-11-05T10:17:26.501Z","1.0.0":"2015-11-05T10:17:26.501Z"},"homepage":"https://github.com/thetutlage/html-to-markdown#readme","keywords":["html-to-markdown","markdown"],"repository":{"type":"git","url":"git+https://github.com/thetutlage/html-to-markdown.git"},"author":{"name":"amanvirk"},"bugs":{"url":"https://github.com/thetutlage/html-to-markdown/issues"},"license":"MIT","readmeFilename":"readme.md","users":{"sfyr111":true}}